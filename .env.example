# Copy to .env. Never put server secrets in VITE_ variables.
BUILDGRAPH_STORAGE=local
BUILDGRAPH_DB=.data/buildgraph.sqlite3
# Explicit model selection required. Verify the model using scripts/check_gemini.py.
GEMINI_API_KEY=
GEMINI_MODEL=
# Only for an explicitly designated Google Cloud deployment:
# GOOGLE_CLOUD_PROJECT=your-buildgraph-project
# BUILDGRAPH_STORAGE=google
# BUILDGRAPH_BUCKET=your-private-buildgraph-artifacts
# BUILDGRAPH_WORKSPACE=demo
